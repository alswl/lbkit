{
  "purpose": "Design seeds for Herdr Collaboration Adapter setup and wait; traces are scripted observations, not claims of implemented CLI or successful integration.",
  "cases": [
    {
      "id": "skill-missing",
      "layers": [
        "skill-eval",
        "integration"
      ],
      "trace": [
        "bundled_skill_available",
        "controller_skill_absent"
      ],
      "expect": [
        "report missing installation",
        "do not claim ready from CLI availability"
      ]
    },
    {
      "id": "skill-stale",
      "layers": [
        "skill-eval",
        "integration"
      ],
      "trace": [
        "controller_skill_discoverable",
        "bundled_skill_differs"
      ],
      "expect": [
        "report installed but stale/customized",
        "read bundled guidance",
        "do not silently overwrite"
      ]
    },
    {
      "id": "integration-distinct",
      "layers": [
        "skill-eval",
        "integration"
      ],
      "trace": [
        "controller_skill_current",
        "runtime_integration_outdated"
      ],
      "expect": [
        "report integration separately",
        "do not alter hooks implicitly"
      ]
    },
    {
      "id": "old-idle",
      "layers": [
        "cli-unit",
        "cli-e2e"
      ],
      "trace": [
        "baseline idle",
        "idle",
        "idle",
        "done_seen_flag_change"
      ],
      "expect": [
        "no new settled event",
        "bounded ordinary checks",
        "no Task write"
      ]
    },
    {
      "id": "working-settled",
      "layers": [
        "cli-unit",
        "cli-e2e"
      ],
      "trace": [
        "baseline idle",
        "working",
        "done",
        "idle_seen_flag_change"
      ],
      "expect": [
        "one settled event",
        "Captain must read and judge"
      ]
    },
    {
      "id": "blocked-first",
      "layers": [
        "cli-unit",
        "cli-e2e"
      ],
      "trace": [
        "baseline idle",
        "blocked",
        "blocked"
      ],
      "expect": [
        "one needs_input event",
        "no automatic approval",
        "same observation suppressed on continuation"
      ]
    },
    {
      "id": "fast-turn-gap",
      "layers": [
        "cli-unit",
        "cli-e2e"
      ],
      "trace": [
        "baseline idle",
        "input delivered",
        "unobserved working then idle",
        "observed idle"
      ],
      "expect": [
        "gap or uncorrelated snapshot",
        "no correlated completion",
        "no resend"
      ]
    },
    {
      "id": "multiple-any",
      "layers": [
        "cli-unit",
        "cli-e2e"
      ],
      "trace": [
        "A working B working",
        "B blocked A working"
      ],
      "expect": [
        "return B promptly",
        "A pending",
        "cancel A wait worker only"
      ]
    },
    {
      "id": "partial-unavailable",
      "layers": [
        "cli-unit",
        "cli-e2e"
      ],
      "trace": [
        "A working B working",
        "A unreachable B working"
      ],
      "expect": [
        "A unavailable event",
        "B pending",
        "no false exit"
      ]
    },
    {
      "id": "timeout",
      "layers": [
        "cli-unit",
        "cli-e2e"
      ],
      "trace": [
        "baseline working",
        "working until deadline"
      ],
      "expect": [
        "timeout with continuation",
        "worker remains running",
        "no resend"
      ]
    },
    {
      "id": "interrupt",
      "layers": [
        "cli-unit",
        "cli-e2e"
      ],
      "trace": [
        "A working B working",
        "caller cancels wait"
      ],
      "expect": [
        "interrupted",
        "wait workers cleaned",
        "Sailors remain running"
      ]
    },
    {
      "id": "identity-change",
      "layers": [
        "cli-unit",
        "cli-e2e"
      ],
      "trace": [
        "session s1 working",
        "same pane session s2 idle"
      ],
      "expect": [
        "identity_changed",
        "invalidate correlation",
        "no automatic rebind"
      ]
    },
    {
      "id": "restart-token",
      "layers": [
        "cli-unit",
        "cli-e2e"
      ],
      "trace": [
        "settled event e1 delivered",
        "restart with continuation",
        "same settled state"
      ],
      "expect": [
        "no new business effect from e1",
        "disclose gaps during downtime"
      ]
    },
    {
      "id": "restart-no-token",
      "layers": [
        "cli-unit",
        "cli-e2e"
      ],
      "trace": [
        "restart without saved baseline",
        "idle"
      ],
      "expect": [
        "uncorrelated snapshot",
        "no replay claim"
      ]
    },
    {
      "id": "new-cycle",
      "layers": [
        "cli-unit",
        "cli-e2e"
      ],
      "trace": [
        "working",
        "idle cycle1",
        "working",
        "idle cycle2"
      ],
      "expect": [
        "two distinct settled observations",
        "seen-flag flips do not add events"
      ]
    },
    {
      "id": "existing-blocked",
      "layers": [
        "cli-unit",
        "cli-e2e"
      ],
      "trace": [
        "first observation blocked",
        "rearm unchanged blocked"
      ],
      "expect": [
        "first current needs_input",
        "no busy-loop on same UI"
      ]
    },
    {
      "id": "batch-ready",
      "layers": [
        "cli-unit",
        "cli-e2e"
      ],
      "trace": [
        "A working B working",
        "A done and B blocked before drain"
      ],
      "expect": [
        "both ready observations returned within bound",
        "overflow explicitly retained"
      ]
    },
    {
      "id": "host-no-resume",
      "layers": [
        "skill-eval",
        "integration"
      ],
      "trace": [
        "monitor process finishes",
        "host has no pending-return or notification"
      ],
      "expect": [
        "report continuation unavailable",
        "do not claim Captain wakes automatically"
      ]
    },
    {
      "id": "worker-cleanup",
      "layers": [
        "cli-unit",
        "cli-e2e"
      ],
      "trace": [
        "A wait child blocked",
        "B needs_input",
        "coordinator returns"
      ],
      "expect": [
        "A wait child terminated and reaped",
        "A Sailor remains alive",
        "one JSON response"
      ]
    },
    {
      "id": "global-deadline",
      "layers": [
        "cli-unit",
        "cli-e2e"
      ],
      "trace": [
        "targets exceed subprocess limit",
        "some workers queued",
        "overall deadline reached"
      ],
      "expect": [
        "queue time consumes deadline",
        "no per-worker deadline reset",
        "bounded cleanup"
      ]
    },
    {
      "id": "lightweight-observation",
      "layers": [
        "cli-unit",
        "cli-e2e"
      ],
      "trace": [
        "idle workers perform repeated checks"
      ],
      "expect": [
        "agent lifecycle reads only",
        "no terminal read per heartbeat",
        "no model wake for unchanged state"
      ]
    },
    {
      "id": "captain-host-return",
      "layers": [
        "cli-unit",
        "cli-e2e",
        "integration"
      ],
      "trace": [
        "Captain starts lb agent wait",
        "Sailor settles",
        "wait command exits"
      ],
      "expect": [
        "host delivers result to Captain without repeated model polling",
        "if unsupported mark route limited"
      ]
    },
    {
      "id": "stdout-bound",
      "layers": [
        "cli-unit",
        "cli-e2e"
      ],
      "trace": [
        "Herdr child emits oversized or malformed output"
      ],
      "expect": [
        "cap buffered output",
        "report runtime unavailable",
        "clean up child without killing server"
      ]
    }
  ]
}
