#!/usr/bin/env python3
"""Install lbkit as a submodule and expose its shared entry points."""

from __future__ import annotations

import argparse
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path


class InstallError(Exception):
    pass


def git(repo: Path, *args: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(
        ["git", "-C", str(repo), *args],
        text=True,
        capture_output=True,
        check=False,
    )
    if check and result.returncode:
        raise InstallError(result.stderr.strip() or f"git {' '.join(args)} failed")
    return result


def repository_root(path: Path) -> Path:
    root = Path(git(path, "rev-parse", "--show-toplevel").stdout.strip()).resolve()
    if root != path.resolve():
        raise InstallError(f"--repo must be the Git repository root: {root}")
    return root


def manifest(kit: Path) -> dict[Path, Path]:
    skills = kit / "skills"
    docs = kit / "docs/installable"
    required = [kit / "bin/lb", kit / "bin/lb-anywhere", kit / "bin/lbkit", kit / "scripts/lb.py", kit / "src/logbook_cli", kit / "lbkit-agents.template.yaml", kit / "AGENTS.template.md", kit / "pyproject.toml", kit / "uv.lock"]
    if any(not path.exists() for path in required) or not skills.is_dir() or not docs.is_dir():
        raise InstallError(f"incomplete lbkit checkout: {kit}")
    mapping = {
        Path("bin/lb"): Path(".lbkit/bin/lb"),
        Path("bin/lb-anywhere"): Path(".lbkit/bin/lb-anywhere"),
        Path("bin/lbkit"): Path(".lbkit/bin/lbkit"),
    }
    for skill in sorted(skills.iterdir()):
        if skill.is_dir() and (skill / "SKILL.md").is_file():
            mapping[Path(".agents/skills") / skill.name] = Path(".lbkit/skills") / skill.name
            mapping[Path(".claude/skills") / skill.name] = Path(".lbkit/skills") / skill.name
    for doc in sorted(docs.glob("*.md")):
        mapping[Path("docs") / doc.name] = Path(".lbkit/docs/installable") / doc.name
    return mapping


def relative_link(link: Path, target: Path) -> str:
    return os.path.relpath(target, link.parent)


def legacy_contract_link(repo: Path, link_rel: Path, target_rel: Path) -> bool:
    """Recognize only the previous installer-owned contract symlink."""
    link = repo / link_rel
    return (
        link_rel.parent == Path("docs")
        and target_rel.parent == Path(".lbkit/docs/installable")
        and link.is_symlink()
        and os.readlink(link) == relative_link(link, repo / ".lbkit/docs" / link_rel.name)
    )


def conflicts(repo: Path, mapping: dict[Path, Path]) -> list[Path]:
    blocked = []
    for link_rel, target_rel in mapping.items():
        link = repo / link_rel
        expected = relative_link(link, repo / target_rel)
        if link.is_symlink():
            if os.readlink(link) != expected and not legacy_contract_link(repo, link_rel, target_rel):
                blocked.append(link_rel)
        elif link.exists():
            blocked.append(link_rel)
    return blocked


def install_links(repo: Path, mapping: dict[Path, Path]) -> list[Path]:
    created = []
    for link_rel, target_rel in mapping.items():
        link = repo / link_rel
        if link.is_symlink():
            if not legacy_contract_link(repo, link_rel, target_rel):
                continue
            link.unlink()
        link.parent.mkdir(parents=True, exist_ok=True)
        link.symlink_to(relative_link(link, repo / target_rel), target_is_directory=(repo / target_rel).is_dir())
        created.append(link_rel)
    return created


def source_url(kit: Path, supplied: str | None) -> str:
    if supplied:
        return supplied
    result = git(kit, "remote", "get-url", "origin", check=False)
    if result.returncode or not result.stdout.strip():
        raise InstallError("supply --source with the lbkit Git URL")
    return result.stdout.strip()


def init_mind_forge(repo: Path, dry_run: bool) -> str | None:
    """Require mind-forge and bootstrap without replacing consumer content."""
    if dry_run:
        return "mind-forge is required; verify mf and initialize minds.yaml if absent"
    if shutil.which("mf") is None:
        raise InstallError("mind-forge is required: install mf from https://github.com/alswl/mind-forge using scripts/install.sh, then retry")
    version = subprocess.run(["mf", "version"], capture_output=True, text=True)
    if version.returncode:
        raise InstallError(f"mind-forge is required and must be runnable: {version.stderr.strip()}")
    if (repo / "minds.yaml").is_symlink():
        raise InstallError("minds.yaml must not be a symlink")
    if (repo / "minds.yaml").is_file():
        return None
    if (repo / "minds.yaml").exists():
        raise InstallError("minds.yaml must be a regular file")
    if (repo / "projects").is_symlink() or ((repo / "projects").exists() and not (repo / "projects").is_dir()):
        raise InstallError("projects must be a real directory")
    with tempfile.TemporaryDirectory() as scratch:
        result = subprocess.run(["mf", "init", scratch], capture_output=True, text=True)
        if result.returncode:
            raise InstallError(f"mf init failed: {result.stderr.strip()}")
        generated = Path(scratch)
        if not (generated / "minds.yaml").is_file() or not (generated / "projects").is_dir():
            raise InstallError("mf init did not produce minds.yaml and projects/")
        # Initialization must never merge example content over existing projects.
        for path in (generated / "projects").rglob("*"):
            target = repo / "projects" / path.relative_to(generated / "projects")
            if target.is_symlink() or (target.exists() and not (path.is_dir() and target.is_dir())):
                raise InstallError(f"mind-forge initialization would replace {target}")
        shutil.copytree(generated / "projects", repo / "projects", dirs_exist_ok=True)
        shutil.copy2(generated / "minds.yaml", repo / "minds.yaml")
    return None


def legacy_config_hint(repo: Path) -> None:
    """lbkit-agents.yaml used to live at .agents/lb.yaml; never move it silently."""
    if (repo / ".agents/lb.yaml").exists() and not (repo / "lbkit-agents.yaml").exists():
        print("Move the agent config to the repository root: git mv .agents/lb.yaml lbkit-agents.yaml")


def install_runtime(kit: Path) -> None:
    """Install the pinned CLI environment only during explicit installation."""
    if shutil.which("uv") is None:
        raise InstallError("uv is required: install uv, then rerun lbkit install")
    env = dict(os.environ, UV_PROJECT_ENVIRONMENT=str(kit / ".venv"))
    env.pop("VIRTUAL_ENV", None)
    result = subprocess.run(["uv", "sync", "--locked", "--no-dev", "--project", str(kit)], env=env, text=True, capture_output=True)
    if result.returncode:
        raise InstallError(f"CLI environment installation failed: {result.stderr.strip()}")


def install(repo: Path, kit: Path, source: str | None, dry_run: bool) -> None:
    repo = repository_root(repo)
    planned = manifest(kit)
    blocked = conflicts(repo, planned)
    if blocked:
        raise InstallError("existing paths would be replaced: " + ", ".join(map(str, blocked)))

    destination = repo / ".lbkit"
    indexed = git(repo, "ls-files", "--stage", "--", ".lbkit").stdout.strip()
    registered = indexed.startswith("160000 ")
    if destination.exists() and not registered:
        raise InstallError(".lbkit exists but is not an indexed submodule")
    url = source_url(kit, source) if not registered else None
    had_minds = (repo / "minds.yaml").exists()
    if not dry_run:
        init_mind_forge(repo, dry_run=False)
    if not registered:
        if dry_run:
            print(f"git submodule add {url} .lbkit")
        else:
            git(repo, "submodule", "add", url, ".lbkit")
    elif not (destination / "bin/lb").exists():
        if dry_run:
            print("git submodule update --init .lbkit")
        else:
            git(repo, "submodule", "update", "--init", ".lbkit")

    if dry_run:
        print("uv sync --locked --no-dev --project .lbkit")
        for link_rel, target_rel in planned.items():
            print(f"{link_rel} -> {relative_link(repo / link_rel, repo / target_rel)}")
        if not (repo / "lbkit-agents.yaml").exists() and not (repo / ".agents/lb.yaml").exists():
            print("lbkit-agents.yaml <- .lbkit/lbkit-agents.template.yaml")
        if not (repo / "AGENTS.md").exists():
            print("AGENTS.md <- lbkit stub (fill in local rules)")
        if not (repo / "CLAUDE.md").exists() and not (repo / "CLAUDE.md").is_symlink():
            print("CLAUDE.md -> AGENTS.md")
        if not (repo / "minds.yaml").exists():
            print("mind-forge required: verify mf; initialize minds.yaml + projects/ via mf init")
        legacy_config_hint(repo)
        return

    actual = manifest(destination)
    blocked = conflicts(repo, actual)
    if blocked:
        raise InstallError("installed lbkit conflicts with existing paths: " + ", ".join(map(str, blocked)))
    install_runtime(destination)
    created = install_links(repo, actual)
    if not (repo / "lbkit-agents.yaml").exists() and not (repo / ".agents/lb.yaml").exists():
        with (repo / "lbkit-agents.yaml").open("x", encoding="utf-8") as target:
            target.write((destination / "lbkit-agents.template.yaml").read_text(encoding="utf-8"))
    if not (repo / "AGENTS.md").exists():
        (repo / "AGENTS.md").write_text((destination / "AGENTS.template.md").read_text(encoding="utf-8"), encoding="utf-8")
        created.append(Path("AGENTS.md"))
    claude_md = repo / "CLAUDE.md"
    if not claude_md.exists() and not claude_md.is_symlink():
        claude_md.symlink_to("AGENTS.md")
        created.append(Path("CLAUDE.md"))
    if not had_minds:
        created.append(Path("minds.yaml"))
    result = subprocess.run([str(repo / "bin/lb"), "--help"], cwd=repo, capture_output=True, text=True)
    if result.returncode:
        raise InstallError(f"bin/lb validation failed: {result.stderr.strip()}")
    print(f"lbkit ready at {destination}; installed {len(created)} entries")
    print("Fill lbkit-agents.yaml as needed; keep AGENTS.md and lbkit-agents.yaml in the consuming repository.")
    legacy_config_hint(repo)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)
    command = subparsers.add_parser("install", help="add .lbkit submodule and shared links")
    command.add_argument("--repo", type=Path, default=Path.cwd(), help="target Git repository root")
    command.add_argument("--source", help="lbkit Git URL; defaults to this checkout's origin")
    command.add_argument("--dry-run", action="store_true", help="show planned operations without writing")
    args = parser.parse_args(argv)
    try:
        install(args.repo, Path(__file__).resolve().parents[1], args.source, args.dry_run)
    except (InstallError, OSError) as exc:
        print(f"lbkit: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
