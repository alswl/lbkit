{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lbkit skill recipes",
  "type": "object",
  "required": [
    "version",
    "recipes"
  ],
  "properties": {
    "version": {
      "const": "0.2.0"
    },
    "recipes": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "status",
          "applies_to",
          "excludes",
          "steps",
          "companions"
        ],
        "properties": {
          "status": {
            "enum": [
              "draft",
              "available",
              "deprecated",
              "retired"
            ]
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "applies_to": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "excludes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "companions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "skill",
                "when"
              ],
              "properties": {
                "skill": {
                  "type": "string",
                  "minLength": 1
                },
                "when": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
